{{#server_blocks}}
{{#domains}}{{address}} {{/domains}}{
    import access_log {{primary_domain}}
    import compression
    import security_headers

    {{#is_backend}}
    bind{{#backend_listeners}} {{ip}}{{/backend_listeners}}
    map {http.request.header.X-Forwarded-Proto} {{backend_https}} {
        default off
        https on
    }
    route {
        @untrusted not remote_ip{{#trusted_proxies}} {{ip}}{{/trusted_proxies}}
        respond @untrusted 403
    {{/is_backend}}

    {{#has_tls}}
    tls {{ssl_certificate_path}} {{ssl_certificate_key_path}}
    {{/has_tls}}

    {{#basic_auth_enabled}}
    basic_auth {
        {{#basic_auth_users}}
        {{username}} {{bcrypt}}
        {{/basic_auth_users}}
    }
    {{/basic_auth_enabled}}

    {{#verification_key}}
    handle_path /.well-known/vito/{{verification_key}}/* {
        root * /var/lib/vito/verify/{{verification_key}}
        header Cache-Control "no-store"
        file_server
    }
    {{/verification_key}}

    {{#is_component}}
    handle {
        @hidden path_regexp hidden (^|/)\.
        respond @hidden 404
    {{/is_component}}
    {{#is_php}}
    root * {{root}}
    {{#request_body_max_size}}request_body {
        max_size {{request_body_max_size}}
    }
    {{/request_body_max_size}}
    try_files {path} {path}/ /index.php?{query}
    {{#is_backend}}
    php_fastcgi {{php_socket}} {
        trusted_proxies{{#trusted_proxies}} {{ip}}{{/trusted_proxies}}
        env HTTPS {{backend_https}}
        env REMOTE_ADDR {http.request.header.X-Real-IP}
    }
    {{/is_backend}}
    {{^is_backend}}
    php_fastcgi {{php_socket}}{{#php_value}} {
        env PHP_VALUE "@@VITO_PHP_VALUE@@"
    }{{/php_value}}
    {{/is_backend}}
    file_server
    {{/is_php}}

    {{#is_octane}}
    root * {{root}}
    @notStatic {
        not file {path}
    }
    reverse_proxy @notStatic 127.0.0.1:{{octane_port}}
    file_server
    {{/is_octane}}

    {{#is_static}}
    root * {{root}}
    file_server
    {{/is_static}}
    {{#is_component_proxy}}
    reverse_proxy {{proxy_address}}{{#is_backend}} {
        trusted_proxies{{#trusted_proxies}} {{ip}}{{/trusted_proxies}}
        header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
        header_up X-Forwarded-Host {host}
    }{{/is_backend}}
    {{/is_component_proxy}}
    {{#is_reverse_proxy}}
    reverse_proxy localhost:{{port}}
    {{/is_reverse_proxy}}

    {{#is_load_balancer}}
    {{#is_component}}
    {{^has_lb_servers}}respond 503{{/has_lb_servers}}
    {{/is_component}}
    {{#render_lb_proxy}}
    reverse_proxy {
        {{#lb_servers}}
        to {{address}}
        {{/lb_servers}}
        {{^lb_servers}}
        to 127.0.0.1
        {{/lb_servers}}
        lb_policy {{lb_policy}}
        {{#is_component}}
        fail_duration 10s
        max_fails 3
        unhealthy_status 5xx
        header_up X-Forwarded-Host {host}
        {{/is_component}}
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    {{/render_lb_proxy}}
    {{/is_load_balancer}}

    {{#redirects}}
    {{#is_proxy}}
    handle_path {{from}}/* {
        reverse_proxy {{to}} {
            header_up Host {http.reverse_proxy.upstream.hostport}
            header_up X-Real-IP {http.request.remote}
            header_up X-Forwarded-For {http.request.remote}
            header_up X-Forwarded-Proto {http.request.scheme}
        }
    }
    {{/is_proxy}}
    {{^is_proxy}}
    @exactPath{{id}} path {{from}}
    redir @exactPath{{id}} {{to}} {{mode}}
    {{/is_proxy}}
    {{/redirects}}
    {{#is_component}}
    }
    {{/is_component}}
    {{#is_backend}}
    }
    {{/is_backend}}
}

{{/server_blocks}}

{{#has_http_verification}}
{{#http_verification_domains}}{{address}} {{/http_verification_domains}}{
    handle_path /.well-known/vito/{{verification_key}}/* {
        root * /var/lib/vito/verify/{{verification_key}}
        header Cache-Control "no-store"
        file_server
    }

    handle {
        redir https://{host}{uri} permanent
    }
}

{{/has_http_verification}}
{{#redirect_blocks}}
{{#domains}}{{address}} {{/domains}}{
    {{#has_tls}}
    tls {{ssl_certificate_path}} {{ssl_certificate_key_path}}
    {{/has_tls}}

    {{#verification_key}}
    handle_path /.well-known/vito/{{verification_key}}/* {
        root * /var/lib/vito/verify/{{verification_key}}
        header Cache-Control "no-store"
        file_server
    }
    {{/verification_key}}

    handle {
        redir {{redirect_scheme}}://{{redirect_target}}{uri} permanent
    }
}

{{/redirect_blocks}}
